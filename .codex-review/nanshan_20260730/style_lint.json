      "para_index": 1,
      "text": "\u521d\u4e2d\u6570\u5b66AI\u9605\u5377\u7684\u9898\u578b\u8bef\u5dee\u4e0e\u6559\u5e08\u590d\u6838\u2014\u2014\u57fa\u4e8e78\u4efd\u4e03\u5e74\u7ea7\u7eb8\u7b14\u7b54\u5377\u7684\u5b9e\u8df5\u5206\u6790",
      "style": "Nanshan Title"
    },
    {
      "para_index": 4,
      "text": "\u3010\u5173\u952e\u8bcd\u3011\u4eba\u5de5\u667a\u80fd\u3000\u3000\u521d\u4e2d\u6570\u5b66\u3000\u3000\u667a\u80fd\u9605\u5377\u3000\u3000\u9898\u578b\u8bef\u5dee\u3000\u3000\u6559\u5e08\u590d\u6838",
