    },
    {
      "para_index": 23,
      "text": "\u88681 \u8bd5\u5377\u9898\u578b\u7ed3\u6784\u4e0e\u8bc4\u5206\u4efb\u52a1\u7279\u5f81",
      "style": "Nanshan Caption"
    },
    {
      "para_index": 27,
      "text": "\u88682 AI \u9605\u5377\u7684\u56fe\u50cf\u8f93\u5165\u3001\u6a21\u578b\u53c2\u6570\u4e0e\u65e5\u5fd7\u8bb0\u5f55\u8bbe\u7f6e",
      "style": "Nanshan Caption"
    },
    {
      "para_index": 34,
      "text": "\u88683 AI \u539f\u59cb\u5206\u4e0e\u6d41\u7a0b\u6700\u7ec8\u5206\u76f8\u5bf9\u4e8e\u6559\u5e08\u624b\u6539\u5206\u7684\u603b\u5206\u5dee\u5f02\u53ca\u4e00\u81f4\u6027",
      "style": "Nanshan Caption"
    },
    {
      "para_index": 37,
      "text": "\u56fe1 \u6d41\u7a0b\u6700\u7ec8\u5206\u4e0e\u6559\u5e08\u624b\u6539\u5206\u7684 Bland-Altman \u4e00\u81f4\u6027\u5206\u6790",
      "style": "Nanshan Caption"
    },
    {
      "para_index": 39,
      "text": "\u88684 \u6392\u9664 Q10 \u4f5c\u56fe\u9898\u524d\u540e\u6d41\u7a0b\u6700\u7ec8\u5206\u4e0e\u6559\u5e08\u624b\u6539\u5206\u7684\u5dee\u5f02\u53ca\u4e00\u81f4\u6027",
      "style": "Nanshan Caption"
    },
    {
      "para_index": 42,
      "text": "\u56fe2 \u6392\u9664 Q10 \u524d\u540e\u6d41\u7a0b\u6700\u7ec8\u5206\u7684 Bias \u53d8\u5316",
      "style": "Nanshan Caption"
    },
    {
      "para_index": 44,
      "text": "\u88685 \u4e0d\u540c\u9898\u578b\u4e0b\u4e24\u79cd\u6a21\u5f0f\u6d41\u7a0b\u6700\u7ec8\u5206\u7684 MAE\u3001\u76f8\u5bf9 MAE \u4e0e Bias",
      "style": "Nanshan Caption"
    },
    {
      "para_index": 47,
      "text": "\u56fe3 \u4e0d\u540c\u9898\u578b\u4e0b\u4e24\u79cd AI \u6279\u6539\u6a21\u5f0f\u7684\u6807\u51c6\u5316 MAE",
      "style": "Nanshan Caption"
    },
    {
      "para_index": 49,
      "text": "\u88686 \u4e24\u79cd\u6a21\u5f0f\u4e2d\u201c\u9700\u8981\u590d\u6838\u201d\u5b57\u6bb5\u53ca\u76f8\u5e94\u6539\u5206\u8bb0\u5f55",
      "style": "Nanshan Caption"
    },
    {
      "para_index": 60,
      "text": "\u88687 \u672c\u6b21\u9898\u578b\u7ed3\u679c\u4e0e\u6682\u5b9a\u5904\u7406\u65b9\u5f0f",
      "style": "Nanshan Caption"
    },
