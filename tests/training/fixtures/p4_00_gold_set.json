  "fault_matrix": [
    {
      "category": "duplicate_operation",
      "trigger": "重复提交同一关系建议、题目分析、生成卷、归卷、判定或证据发布命令",
      "expected": "返回已有 operation 或结果，不重复写入、不重复收费"
    },
    {
      "category": "concurrent_operation",
      "trigger": "两个页面用同一旧 revision 同时确认关系、修改判定点或归卷",
      "expected": "只允许一个提交成功，另一提交明确返回 revision 冲突"
    },
    {
      "category": "mid_operation_exit",
      "trigger": "事务或文件发布中途退出",
      "expected": "数据库回滚，文件保留在可识别暂存区，旧正式版本不变"
    },
    {
      "category": "restart",
      "trigger": "应用在 Job、归卷、判定或 outbox 未结束时重启",
      "expected": "从明细恢复、重算或安全收口，不猜测完成"
    },
    {
      "category": "retry_after_failure",
      "trigger": "模型、文件或跨库发布失败后教师重试",
      "expected": "仅显式重试失败部分；成功部分和已收费 operation 不重复"
    },
    {
      "category": "cancel",
      "trigger": "教师取消部分完成的生成、归卷或判定",
      "expected": "已正式发布结果保留，未完成项不伪装为未达成或零"
    },
    {
      "category": "partial_completion",
      "trigger": "标签成功而判定点失败，或部分题等待教师复核",
      "expected": "每个投影和每道题显示真实状态，互不回滚已成功结果"
    },
    {
      "category": "missing_data",
      "trigger": "关系、判定点、页面、答案或掌握证据缺失",
      "expected": "明确降级或阻断，不推断、不补造、不调用不必要模型"
    },
    {
      "category": "conflicting_data",
      "trigger": "题目版本、页面身份、教师锁或跨库版本冲突",
      "expected": "失败关闭并保留可人工核对的来源和旧正式版本"
    },
    {
      "category": "file_failure",
      "trigger": "DOCX、PDF、扫描暂存或原子发布失败",
      "expected": "不覆盖旧文件，不发布半份文件，临时文件可识别并可恢复"
    },
    {
      "category": "model_failure",
      "trigger": "超时、取消、坏 JSON、漏点、重复点或未知 point_id",
      "expected": "不自动追加请求，不发布非法训练证据，不影响普通考试"
    },
    {
      "category": "page_identity_failure",
      "trigger": "缺页、重页、错页、外批页、签名失败或同身份不同图像",
      "expected": "在模型调用前进入人工队列"
    }
  ],
