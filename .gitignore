# Python cache and test output
__pycache__/
*.py[cod]
.pytest_cache/

# Local environment and secrets
.env
.env.*
*.local

# Logs and generated runtime data
logs/
user_data/**
!user_data/
!user_data/**/
!user_data/**/.gitkeep

# Versioned question-bank corpus.
# Keep API profiles, grading data, backups, and generated exports ignored,
# but allow GitHub sync of imported papers, parsed rich content, images, and AI tags.
!user_data/databases/question_bank.db
!user_data/question_bank/raw_papers/**
!user_data/question_bank/extracted_images/**
!user_data/question_bank/rich_content/**

# Packaged runtime and build outputs
runtime/
dist/
build/

# Temporary files
*.tmp
*.bak
*.log

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
