{
  "name": "ai-grading-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "npm": "11.8.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run build-only",
    "build-only": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "verify": "npm run lint && npm run test && npm run build",
    "demo:p2-08": "node demo/p2-08-server.mjs",
    "demo:phase2-recalibration": "node demo/p2-08-server.mjs",
    "demo:test": "node --test demo/p2-08-server.test.mjs",
    "e2e:p2-08:prepared": "playwright test --config playwright.p2-08.config.ts",
    "e2e:p2-08": "npm run build && npm run e2e:p2-08:prepared",
    "e2e:p2-10-real:prepared": "playwright test --config playwright.p2-10-real.config.ts",
    "e2e:p2-10-real": "npm run build && npm run e2e:p2-10-real:prepared",
    "e2e:p2-13-real:prepared": "playwright test --config playwright.p2-13-real.config.ts",
    "e2e:p2-13-real": "npm run build && npm run e2e:p2-13-real:prepared",
    "e2e:p2-16-real:prepared": "playwright test --config playwright.p2-16-real.config.ts",
    "e2e:p2-16-real": "npm run build && npm run e2e:p2-16-real:prepared",
    "e2e:phase2-recalibration:prepared": "npm run e2e:p2-08:prepared",
    "e2e:phase2-recalibration": "npm run build && npm run e2e:phase2-recalibration:prepared",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "element-plus": "2.14.3",
    "pinia": "3.0.4",
    "vue": "3.5.39",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tsconfig/node24": "24.0.4",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/eslint-plugin": "1.6.20",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.7.0",
    "eslint-plugin-playwright": "2.10.4",
    "eslint-plugin-vue": "10.9.2",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}
